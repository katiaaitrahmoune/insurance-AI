# ---- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
ENABLE_DOCS=true        # Swagger UI at /api/docs (set false in production if you prefer)

# ---- PostgreSQL ---------------------------------------------------------------
# Local / docker-compose:  postgres://insura:insura@127.0.0.1:5432/insuralens
# Neon:                    postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgres://insura:insura@127.0.0.1:5432/insuralens
DB_POOL_MAX=10          # use 5 on Neon's free plan
RUN_MIGRATIONS_ON_START=true

# ---- Auth (demo-grade by design; swap services/auth.service.js for real SSO) -
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
ALLOW_DEMO_LOGIN=true
DEMO_PASSWORD=demo123

# ---- CORS: comma-separated frontend origins ---------------------------------
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://insura-lens.vercel.app

# ---- insuralens-mcp ----------------------------------------------------------
MCP_URL=http://127.0.0.1:5100/mcp
MCP_PORT=5100
# Two callers, two tokens: the agent graph can only reach get_policy; the review endpoint only update_claim.
MCP_GRAPH_TOKEN=change-me-graph-token
MCP_REVIEW_TOKEN=change-me-review-token
# Optional: lets the MCP Inspector call both tools during development. Leave empty in production.
MCP_ADMIN_TOKEN=

# ---- AI Engineer integration -------------------------------------------------
AGENT_MODE=fixture
AGENT_STEP_DELAY_MS=1200
GEMINI_API_KEY=

# ---- Files -------------------------------------------------------------------
# local      = files on disk under DATA_DIR (dev, tests). Lost on redeploy on most hosts.
# cloudinary = files in Cloudinary (production). Uploaded as "authenticated": no public URLs,
#              every download goes through this API's auth.
STORAGE_DRIVER=local
DATA_DIR=./data
MAX_UPLOAD_MB=15        # Cloudinary's free plan caps files at 10 MB: use 10
# Either the single URL (Cloudinary dashboard > API Keys > "API environment variable") ...
CLOUDINARY_URL=
# ... or the three parts:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=insuralens
